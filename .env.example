# Copy to ~/.health_tracker/.env (NOT into this repo) and fill in.
# Values come from Google Cloud Console → APIs & Services → Credentials →
# your "Web application" OAuth 2.0 Client ID.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Port the local server listens on (127.0.0.1 only). The OAuth redirect URI
# registered in Google Cloud must be http://localhost:<PORT>/auth/callback
PORT=8787

# Optional: contact shown in the User-Agent sent to Open Food Facts (their API
# policy asks apps to identify themselves). Leave blank to send none.
OFF_CONTACT=
