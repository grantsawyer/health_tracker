{
  "name": "health-tracker",
  "version": "0.2.0",
  "description": "Personal dashboard for Google Health data (fitness, sleep, nutrition) with food logging",
  "scripts": {
    "dev": "vite",
    "dev:server-mode": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web-server-mode\"",
    "dev:server": "APP_ORIGIN=http://localhost:5173 tsx watch server/index.ts",
    "dev:web-server-mode": "VITE_BACKEND=server vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "check:privacy": "node scripts/check-secrets.mjs && node scripts/check-privacy.mjs",
    "check:secrets:history": "node scripts/check-secrets.mjs --history",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:privacy:history": "node scripts/check-privacy.mjs --history"
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "dotenv": "^18.0.9",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "fake-indexeddb": "6.2.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
