# Real secrets, tokens, and cached health data live in ~/.health_tracker
# (HEALTH_TRACKER_HOME), never in this repo. These rules are a safety net.

# Secrets and tokens
.env
.env.*
!.env.example
*.enc
*.key
*.pem
client_secret*.json
credentials*.json

# Cached data
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Build / deps
node_modules/
dist/

# Logs
*.log

# macOS
.DS_Store

# Test output
test-results/
playwright-report/

# Reference screenshots from the Google Health app: personal health data, never commit
samples/

# Coding-agent local state. Claude Code's "Yes, and don't ask again" saves the full approved command (including any
# secret typed into it) to .claude/settings.local.json, and only ignores that file in the user's global gitignore,
# which other clones and machines don't have. Ignore it here too; scripts/check-secrets.mjs also refuses to commit it.
# Every agent folder is treated like .env (settings, approved commands, memory, chat logs). CLAUDE.md at the repo
# root is the one deliberate exception: shared project instructions, scanned like any other file.
.claude/
.cursor/
.gemini/
.specstory/
.codex/
.aider*
CLAUDE.local.md
AGENTS.local.md
GEMINI.local.md
.mcp.json
